# Settings for this installation. Copy to `wri.env` and edit; `./wri install` does the copy
# and fills in WRI_IMAGE for you. Lines starting with # are comments.

# The image this installation runs. Set by `./wri install` and `./wri upgrade`.
WRI_IMAGE=wri:CHANGE-ME

# Who can reach the screen.
#   127.0.0.1  only this machine (the default). Put a TLS-terminating reverse proxy in
#              front of it for anyone else. This is the setting to keep.
#   0.0.0.0    anyone who can reach this machine, over plain HTTP: passwords and client data
#              would cross the network unencrypted. Do not use it outside a closed test.
WRI_BIND=127.0.0.1
WRI_PORT=8501

# How long a sign-in lasts, in hours.
WRI_SESSION_HOURS=12

# The largest upload accepted, in megabytes.
WRI_MAX_UPLOAD_MB=50

# Leave empty to use the bundled database, kept in the data volume with everything else.
# Set a SQLAlchemy URL only if the firm runs its own database server; `./wri backup` then
# covers the client files but not the accounts, which must be backed up with that server.
WRI_DATABASE_URL=

# --- Single sign-on (optional) --------------------------------------------------------
# People sign in with the firm's own identity provider (Microsoft Entra ID, Google
# Workspace, Okta, Keycloak: anything that speaks OpenID Connect). Leave WRI_SSO_ISSUER
# empty and none of this applies. "Single sign-on" in INSTALL.md walks through it.

# The provider's issuer address, as it gives it. Must be https.
WRI_SSO_ISSUER=
# What the provider issued when this product was registered with it as an application.
WRI_SSO_CLIENT_ID=
# A SECRET. This file is readable only by the account that owns it; keep it that way.
WRI_SSO_CLIENT_SECRET=
# The https address your people open this product at, ending in a slash. Register exactly
# this with the provider as the redirect address.
WRI_SSO_REDIRECT_URL=
# What the button says: "Sign in with <this>".
WRI_SSO_NAME=
# Leave these three empty unless INSTALL.md tells you your provider needs them.
WRI_SSO_SCOPES=
WRI_SSO_EMAIL_CLAIM=
WRI_SSO_REQUIRE_VERIFIED_EMAIL=

# "off" refuses every password, so only the identity provider signs people in. Set it only
# once an administrator has signed in through the provider. Empty or "on" keeps passwords.
WRI_PASSWORD_SIGN_IN=
